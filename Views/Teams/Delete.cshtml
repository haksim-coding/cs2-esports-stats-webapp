@model cs2_esports.Models.Team
@{
    ViewData["Title"] = "Delete Team";
}

<div class="cs2-glass-card shadow-lg p-4 p-md-5 border-0">
    <div class="border-bottom pb-3 mb-4" style="border-color: rgba(255,255,255,0.08) !important;">
        <h1 class="h3 text-danger fw-bold mb-1">Delete Team</h1>
        <p class="text-muted mb-0">This action removes the team from the rankings and cannot be undone.</p>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="text-secondary small text-uppercase">Name</div>
            <div class="text-light fw-semibold">@Model.Name</div>
        </div>
        <div class="col-md-3">
            <div class="text-secondary small text-uppercase">Tag</div>
            <div class="text-light fw-semibold">@Model.Tag</div>
        </div>
        <div class="col-md-3">
            <div class="text-secondary small text-uppercase">Rank</div>
            <div class="text-light fw-semibold">#@Model.WorldRanking</div>
        </div>
    </div>

    <form asp-action="Delete" method="post" class="d-flex gap-2">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger px-4 fw-bold">Delete Team</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary px-4">Cancel</a>
    </form>
</div>