@model cs2_esports.Models.Player
@{
    ViewData["Title"] = "Delete Player";
}

<div class="cs2-glass-card shadow-lg p-4 p-md-5 border-0">
    <h1 class="h3 text-primary fw-bold mb-3">Delete Player</h1>
    <p class="text-muted mb-4">Are you sure you want to delete @Model.Nickname?</p>

    <dl class="row mb-4">
        <dt class="col-sm-3 text-light">Full name</dt>
        <dd class="col-sm-9 text-muted">@Model.FullName</dd>
        <dt class="col-sm-3 text-light">Role</dt>
        <dd class="col-sm-9 text-muted">@Model.Role</dd>
        <dt class="col-sm-3 text-light">Team</dt>
        <dd class="col-sm-9 text-muted">@(Model.Team?.Name ?? "Free agent")</dd>
    </dl>

    <form action="/players/delete/@Model.Id" method="post" class="d-flex gap-2">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger px-4 fw-bold">Delete</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary px-4">Cancel</a>
    </form>
</div>