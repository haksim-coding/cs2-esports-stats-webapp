@model cs2_esports.Models.PlayerEditModel
@{
    ViewData["Title"] = "Edit Player";
    var dateOfBirthPicker = new cs2_esports.Models.DatePickerInputModel { Name = nameof(Model.DateOfBirth), Value = Model.DateOfBirth, Mode = "date", IsRequired = true, RequiredMessage = "Date of Birth is required." };
}

<div class="cs2-glass-card shadow-lg p-4 p-md-5 border-0">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4 border-bottom pb-3" style="border-color: rgba(255,255,255,0.08) !important;">
        <div>
            <h1 class="h3 text-primary fw-bold mb-1">Edit Player</h1>
            <p class="text-muted mb-0">Update the player profile and team assignment.</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info">Back to player</a>
    </div>

    <form id="playerEditForm" action="/players/edit/@Model.Id" method="post" enctype="multipart/form-data" class="row g-3">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

        <div class="col-md-4">
            <label asp-for="Nickname" class="form-label text-light"></label>
            <input asp-for="Nickname" class="form-control cs2-form-control" />
            <span asp-validation-for="Nickname" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="FullName" class="form-label text-light"></label>
            <input asp-for="FullName" class="form-control cs2-form-control" />
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="CountryCode" class="form-label text-light"></label>
            <input asp-for="CountryCode" class="form-control cs2-form-control" maxlength="2" />
            <span asp-validation-for="CountryCode" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="DateOfBirth" class="form-label text-light"></label>
            <partial name="_DateTimePicker" model="dateOfBirthPicker" />
            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Role" class="form-label text-light"></label>
            <select asp-for="Role" class="form-select cs2-input" asp-items="Html.GetEnumSelectList<cs2_esports.Models.PlayerRole>()"></select>
            <span asp-validation-for="Role" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="TeamId" class="form-label text-light"></label>
            <select asp-for="TeamId" class="form-select cs2-input" asp-items="ViewBag.Teams">
                <option value="">Free agent</option>
            </select>
            <span asp-validation-for="TeamId" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Rating2" class="form-label text-light"></label>
            <input asp-for="Rating2" class="form-control cs2-form-control" />
            <span asp-validation-for="Rating2" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="TotalMapsPlayed" class="form-label text-light"></label>
            <input asp-for="TotalMapsPlayed" class="form-control cs2-form-control" />
            <span asp-validation-for="TotalMapsPlayed" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label class="form-label text-light" for="PlayerImage">Player image</label>
            <div class="upload-file-picker">
            <div class="player-image-upload-layout">
                @if (!string.IsNullOrWhiteSpace(Model.CurrentImagePath))
                {
                    <div class="event-banner-editor__preview event-banner-editor__preview--deletable player-image-editor__preview">
                        <img src="@Url.Content(Model.CurrentImagePath)" alt="@Model.Nickname image" loading="lazy" decoding="async" asp-append-version="true" />
                        <button class="event-banner-editor__delete-button" type="button" data-delete-player-image-url="@Url.Action("DeleteImage", "Players", new { id = Model.Id })" aria-label="Delete player image">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                }
                <div id="playerImageDropzone"
                     class="event-banner-dropzone event-banner-dropzone--async player-image-dropzone dropzone"
                     data-upload-url="/players/@Model.Id/image">
                    <div class="dz-message event-banner-dropzone__message">
                        <span class="event-banner-dropzone__icon"><i class="bi bi-cloud-arrow-up"></i></span>
                        <span class="event-banner-dropzone__copy">
                            <span class="event-banner-dropzone__title">Drop PNG/WebP player image here</span>
                            <span class="event-banner-dropzone__meta">or click to upload. One portrait image, max 4 MB.</span>
                        </span>
                        <span class="event-banner-dropzone__action">Choose file</span>
                    </div>
                </div>
            </div>
            <div class="event-banner-selection-preview player-image-selection-preview" data-player-image-preview hidden>
                <div class="event-banner-selection-preview__media player-image-selection-preview__media">
                    <img alt="Selected player image preview" data-player-image-preview-image />
                </div>
                <div class="event-banner-selection-preview__body">
                    <span class="event-banner-selection-preview__label">Selected image</span>
                    <span class="event-banner-selection-preview__name" data-player-image-preview-name></span>
                </div>
            </div>
            @if (string.IsNullOrWhiteSpace(Model.CurrentImagePath))
            {
                <div class="upload-file-search"
                     data-upload-file-search
                     data-search-url="/players/image/search"
                     data-attach-url="/players/@Model.Id/image/attach">
                    <div class="upload-file-search__heading">
                        <div>
                            <h3 class="upload-file-search__title">Reuse an uploaded player image</h3>
                            <p class="upload-file-search__hint">Showing 5 recent files. Type at least 2 characters to search more.</p>
                        </div>
                        <span class="upload-file-search__status" data-file-search-status aria-live="polite"></span>
                    </div>
                    <label class="upload-file-search__field">
                        <span class="visually-hidden">Search for already uploaded player images</span>
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <input class="form-control cs2-form-control"
                               type="search"
                               placeholder="Search for already uploaded files..."
                               autocomplete="off"
                               data-file-search-input />
                        <span class="spinner-border spinner-border-sm upload-file-search__spinner" role="status" aria-hidden="true" data-file-search-spinner hidden></span>
                    </label>
                    <div class="upload-file-search__results" data-file-search-results aria-live="polite"></div>
                </div>
            }
            </div>
            <span asp-validation-for="PlayerImage" class="text-danger small"></span>
        </div>

        <div class="col-12 d-flex gap-2 mt-2">
            <button type="submit" class="btn btn-primary px-4 fw-bold">Save changes</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary px-4">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.9.3/dropzone.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.9.3/dropzone.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        (() => {
            const deleteButton = document.querySelector('[data-delete-player-image-url]');
            const token = document.querySelector('#playerEditForm input[name="__RequestVerificationToken"]')?.value;
            const fileSearch = document.querySelector('[data-upload-file-search]');
            const dropzoneElement = document.getElementById('playerImageDropzone');

            if (window.Dropzone && dropzoneElement && token) {
                Dropzone.autoDiscover = false;
                new Dropzone(dropzoneElement, {
                    url: dropzoneElement.dataset.uploadUrl,
                    paramName: 'file',
                    maxFiles: 1,
                    maxFilesize: 4,
                    acceptedFiles: 'image/png,image/webp,.png,.webp',
                    addRemoveLinks: true,
                    headers: { RequestVerificationToken: token },
                    init: function () {
                        this.on('success', () => window.location.reload());
                        this.on('maxfilesexceeded', file => this.removeFile(file));
                        this.on('error', (file, response) => {
                            const message = typeof response === 'string'
                                ? response
                                : response?.message || 'Upload failed. Please choose a valid PNG or WebP image.';
                            const errorNode = file.previewElement?.querySelector('[data-dz-errormessage]');
                            if (errorNode) errorNode.textContent = message;
                        });
                    }
                });
            }

            deleteButton?.addEventListener('click', async () => {
                if (!token || !confirm('Delete this player image?')) {
                    return;
                }

                const response = await fetch(deleteButton.dataset.deletePlayerImageUrl, {
                    method: 'POST',
                    headers: {
                        RequestVerificationToken: token
                    }
                });

                if (response.ok) {
                    sessionStorage.setItem('player-image-search-enter', '1');
                    window.location.reload();
                    return;
                }

                alert('Could not delete the player image. Please try again.');
            });

            if (fileSearch) {
                const input = fileSearch.querySelector('[data-file-search-input]');
                const results = fileSearch.querySelector('[data-file-search-results]');
                const status = fileSearch.querySelector('[data-file-search-status]');
                const spinner = fileSearch.querySelector('[data-file-search-spinner]');
                let request;
                let debounce;

                const read = (item, ...keys) => keys.map(key => item?.[key]).find(value => value !== undefined && value !== null);
                const formatSize = value => {
                    const bytes = Number(value);
                    if (!Number.isFinite(bytes)) return 'Size unavailable';
                    if (bytes === 0) return '0 B';
                    const units = ['B', 'KB', 'MB', 'GB'];
                    const unit = Math.min(Math.floor(Math.log(bytes) / Math.log(1024)), units.length - 1);
                    return `${(bytes / Math.pow(1024, unit)).toFixed(unit ? 1 : 0)} ${units[unit]}`;
                };
                const formatDate = value => {
                    const date = value ? new Date(value) : null;
                    return date && !Number.isNaN(date.valueOf())
                        ? new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' }).format(date)
                        : 'Creation date unavailable';
                };
                const showState = (title, copy, icon = 'bi-file-earmark') => {
                    results.replaceChildren();
                    const state = document.createElement('div');
                    state.className = 'upload-file-search__empty';
                    state.innerHTML = `<i class="bi ${icon}" aria-hidden="true"></i><div><strong></strong><span></span></div>`;
                    state.querySelector('strong').textContent = title;
                    state.querySelector('span').textContent = copy;
                    results.append(state);
                };
                const render = payload => {
                    const source = payload?.items ?? payload?.results ?? payload?.files ?? payload;
                    const items = (Array.isArray(source) ? source : source ? [source] : []).filter(Boolean);
                    const query = input.value.trim();
                    status.textContent = items.length ? `${items.length} file${items.length === 1 ? '' : 's'}` : 'No files';

                    if (!items.length) {
                        showState(query ? 'No matching files' : 'No uploaded player images found', query ? 'Try another file name.' : 'Files already stored in the player image folder will appear here.', query ? 'bi-search' : 'bi-folder2-open');
                        return;
                    }

                    results.replaceChildren(...items.map(item => {
                        const path = String(read(item, 'path', 'filePath', 'imagePath') ?? '');
                        const name = String(read(item, 'fileName', 'filename', 'name') ?? path ?? 'Player image');
                        const contentType = String(read(item, 'contentType', 'mimeType', 'type') ?? 'Content type unavailable');
                        const size = read(item, 'sizeBytes', 'fileSize', 'size', 'length');
                        const created = read(item, 'createdAtUtc', 'createdUtc', 'createdAt', 'creationDate', 'uploadedAtUtc');
                        const card = document.createElement('article');
                        card.className = 'upload-file-result';
                        card.innerHTML = `
                            <span class="upload-file-result__thumbnail"><img alt="" loading="lazy" /></span>
                            <div class="upload-file-result__body">
                                <strong class="upload-file-result__name"></strong>
                                <div class="upload-file-result__meta">
                                    <span><i class="bi bi-braces"></i></span>
                                    <span><i class="bi bi-hdd"></i></span>
                                    <span><i class="bi bi-calendar3"></i></span>
                                </div>
                            </div>
                            <button class="btn btn-sm btn-outline-info upload-file-result__attach" type="button">
                                <i class="bi bi-link-45deg" aria-hidden="true"></i> Attach
                            </button>`;
                        card.querySelector('.upload-file-result__name').textContent = name;
                        card.querySelector('img').src = path;
                        card.querySelector('img').alt = `${name} preview`;
                        const meta = card.querySelectorAll('.upload-file-result__meta span');
                        meta[0].append(document.createTextNode(contentType));
                        meta[1].append(document.createTextNode(formatSize(size)));
                        meta[2].append(document.createTextNode(formatDate(created)));
                        card.querySelector('.upload-file-result__attach').addEventListener('click', async event => {
                            const button = event.currentTarget;
                            button.disabled = true;
                            button.innerHTML = '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Attaching';
                            try {
                                const body = new FormData();
                                body.append('path', String(read(item, 'path', 'filePath') ?? ''));
                                const response = await fetch(fileSearch.dataset.attachUrl, {
                                    method: 'POST',
                                    headers: { RequestVerificationToken: token },
                                    body
                                });
                                if (!response.ok) throw new Error();
                                fileSearch.classList.add('is-leaving');
                                window.setTimeout(() => window.location.reload(), 280);
                            } catch {
                                button.disabled = false;
                                button.innerHTML = '<i class="bi bi-link-45deg" aria-hidden="true"></i> Attach';
                                status.textContent = 'Could not attach';
                            }
                        });
                        return card;
                    }));
                };
                const search = async () => {
                    const query = input.value.trim();
                    if (query.length === 1) {
                        request?.abort();
                        status.textContent = '2 characters minimum';
                        showState('Keep typing', 'Enter one more character to search uploaded files.', 'bi-keyboard');
                        return;
                    }
                    request?.abort();
                    const currentRequest = new AbortController();
                    request = currentRequest;
                    spinner.hidden = false;
                    status.textContent = 'Searching...';
                    try {
                        const url = `${fileSearch.dataset.searchUrl}?query=${encodeURIComponent(query)}`;
                        const response = await fetch(url, { headers: { Accept: 'application/json' }, signal: currentRequest.signal });
                        if (!response.ok) throw new Error();
                        render(await response.json());
                    } catch (error) {
                        if (error.name !== 'AbortError') {
                            status.textContent = 'Unavailable';
                            showState('Could not search uploaded files', 'Please try the search again.', 'bi-exclamation-circle');
                        }
                    } finally {
                        if (request === currentRequest) spinner.hidden = true;
                    }
                };

                input.addEventListener('input', () => {
                    window.clearTimeout(debounce);
                    debounce = window.setTimeout(search, 250);
                });
                search();
            }
        })();
    </script>
}
