@model cs2_esports.Models.Match
@{
    ViewData["Title"] = "Delete Match";
}

<div class="cs2-glass-card shadow-lg p-4 p-md-5 border-0">
    <h1 class="h3 text-primary fw-bold mb-3">Delete Match</h1>
    <p class="text-muted mb-4">Are you sure you want to delete match #@Model.Id?</p>

    <dl class="row mb-4">
        <dt class="col-sm-3 text-light">Event</dt>
        <dd class="col-sm-9 text-muted">@(Model.Event?.Name ?? "Unknown")</dd>
        <dt class="col-sm-3 text-light">Teams</dt>
        <dd class="col-sm-9 text-muted">@(Model.TeamA?.Name ?? "TBD") vs @(Model.TeamB?.Name ?? "TBD")</dd>
        <dt class="col-sm-3 text-light">Maps</dt>
        <dd class="col-sm-9 text-muted">@Model.Maps.Count</dd>
    </dl>

    <form asp-action="Delete" method="post" class="d-flex gap-2">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger px-4 fw-bold">Delete</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary px-4">Cancel</a>
    </form>
</div>