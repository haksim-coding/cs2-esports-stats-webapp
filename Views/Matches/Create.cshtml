@model cs2_esports.Models.MatchCreateModel
@{
    ViewData["Title"] = "Create Match";
    var scheduledAtPicker = new cs2_esports.Models.DatePickerInputModel { Name = nameof(Model.ScheduledAtUtc), Value = Model.ScheduledAtUtc, Mode = "datetime", IsRequired = true, RequiredMessage = "Scheduled At is required." };
    var finishedAtPicker = new cs2_esports.Models.DatePickerInputModel { Name = nameof(Model.FinishedAtUtc), Value = Model.FinishedAtUtc, Mode = "datetime" };
}

<div class="cs2-glass-card shadow-lg p-4 p-md-5 border-0">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4 border-bottom pb-3" style="border-color: rgba(255,255,255,0.08) !important;">
        <div>
            <h1 class="h3 text-primary fw-bold mb-1">Create Match</h1>
            <p class="text-muted mb-0">Schedule a new series for an event and assign both teams.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-info">Back to matches</a>
    </div>

    <form action="/matches/create" method="post" class="row g-3">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

        <div class="col-md-4">
            <label asp-for="EventId" class="form-label text-light"></label>
            <select asp-for="EventId" class="form-select cs2-input" asp-items="ViewBag.Events" data-match-event-select data-event-teams-url="@Url.Action("EventTeams", "Matches")">
                <option value="">Select an event</option>
            </select>
            <span asp-validation-for="EventId" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="TeamAId" class="form-label text-light"></label>
            <select asp-for="TeamAId" class="form-select cs2-input" asp-items="ViewBag.TeamOptions" data-match-team-select>
                <option value="">Select Team A</option>
            </select>
            <span asp-validation-for="TeamAId" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="TeamBId" class="form-label text-light"></label>
            <select asp-for="TeamBId" class="form-select cs2-input" asp-items="ViewBag.TeamOptions" data-match-team-select>
                <option value="">Select Team B</option>
            </select>
            <span asp-validation-for="TeamBId" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label class="form-label text-light">Scheduled At</label>
            <partial name="_DateTimePicker" model="scheduledAtPicker" />
            <span asp-validation-for="ScheduledAtUtc" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Format" class="form-label text-light"></label>
            <select asp-for="Format" class="form-select cs2-input" asp-items="Html.GetEnumSelectList<cs2_esports.Models.MatchFormat>()"></select>
            <span asp-validation-for="Format" class="text-danger small"></span>
            <div class="form-text text-secondary">The map editor below expands to match the selected series format.</div>
        </div>
        <div class="col-12">
            <partial name="_MatchMapEditor" model="Model" />
            <div class="form-text text-secondary">Map results are only required when a finished time is set.</div>
        </div>
        <div class="col-md-4">
            <label class="form-label text-light">Finished At</label>
            <partial name="_DateTimePicker" model="finishedAtPicker" />
            <span asp-validation-for="FinishedAtUtc" class="text-danger small"></span>
        </div>

        <div class="col-12 d-flex gap-2 mt-2">
            <button type="submit" class="btn btn-primary px-4 fw-bold">Create</button>
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
